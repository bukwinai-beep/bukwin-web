# --- Database (already in use) ---
DATABASE_URL="file:./db/custom.db"

# --- OpenAI / ChatKit ---
# Server-side key used by your OpenAI Agent Builder workflow (configured in
# the OpenAI dashboard, not in this repo) and/or the existing demo route.
OPENAI_API_KEY=

# Public — safe to expose to the browser. Get these from your published
# Agent Builder ChatKit deployment. See docs/BOOKING-SETUP.md.
NEXT_PUBLIC_CHATKIT_API_URL=
NEXT_PUBLIC_CHATKIT_DOMAIN_KEY=

# --- Google Calendar (server-side only, never NEXT_PUBLIC_*) ---
# Full service-account JSON, either as a raw JSON string or base64-encoded.
GOOGLE_SERVICE_ACCOUNT_KEY=
# The calendar ID to book against. Usually the business Gmail address, or a
# secondary calendar's ID from Google Calendar settings.
GOOGLE_CALENDAR_ID=

# --- Business configuration ---
BUSINESS_NAME="Bukwin AI"
BUSINESS_TIMEZONE="Asia/Karachi"
BUSINESS_HOURS_START="09:00"
BUSINESS_HOURS_END="18:00"
# 0=Sun ... 6=Sat
BUSINESS_WORKING_DAYS="1,2,3,4,5,6"
DEFAULT_APPOINTMENT_DURATION_MINUTES="30"
MAX_BOOKING_HORIZON_DAYS="30"
MIN_BOOKING_NOTICE_MINUTES="60"

# --- Email confirmations (optional but recommended) ---
RESEND_API_KEY=
BUSINESS_EMAIL_FROM="Bukwin AI <bookings@yourdomain.com>"
